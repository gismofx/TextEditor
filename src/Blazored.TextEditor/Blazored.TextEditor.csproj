<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	  <!--netstandard2.0;net9.0;-->
	<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RazorLangVersion>3.0</RazorLangVersion>
    <RootNamespace>Blazored.TextEditor</RootNamespace>

    <Authors>Michael Washington; CPE</Authors>
    <Company>CPE</Company>
    <Description>Rich text editor for Blazor applications, built on Quill JS. Fork of Blazored.TextEditor, which is deprecated and unlisted upstream; adds one-way and two-way content binding and support for multiple editors on a page.</Description>
    <Copyright>Copyright 2025 (c) Michael Washington. All rights reserved.</Copyright>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- NuGet settings -->
    <PackageId>CPE.BlazorQuill</PackageId>
    <!-- Pinned so consumers keep referencing _content/Blazored.TextEditor/... : without this the base path follows PackageId and every consuming index.html would have to change. -->
    <StaticWebAssetBasePath>Blazored.TextEditor</StaticWebAssetBasePath>
    <PackageTags>Blazor;Razor;Components;TextEditor;Rich Text;Quill;QuillJS;ASP.NET Core;CSharp;Web</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/gismofx/TextEditor</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/gismofx/TextEditor</RepositoryUrl>

    <!-- SourceLink settings -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.2.0</Version>
    <PackageReleaseNotes>Fork of Blazored.TextEditor 1.1.3, which is deprecated upstream. Adds one-way and two-way content binding and multiple editors per page.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>
    
  <ItemGroup Condition="'$(TargetFramework)'=='net6.0'">
    <PackageReference Include="Microsoft.JSInterop" Version="6.0.36" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\Blazored-BlazorQuill.js" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
