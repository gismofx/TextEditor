<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	  <!--netstandard2.0;net9.0;-->
	<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RazorLangVersion>3.0</RazorLangVersion>
    <RootNamespace>Blazored.TextEditor</RootNamespace>

    <Authors>Michael Washington; CPE</Authors>
    <Company>CPE</Company>
    <Description>Rich text editor for Blazor applications, built on Quill JS. Fork of Blazored.TextEditor, which is deprecated and unlisted upstream; adds one-way and two-way content binding and support for multiple editors on a page.</Description>
    <!-- MIT requires the original notices to travel with the software. Upstream's two differ from each other (LICENSE says Blazored 2019, upstream metadata says Michael Washington); both are kept, and the fork is added rather than substituted. -->
    <Copyright>Copyright (c) 2019 Blazored; Copyright (c) 2025 Michael Washington; portions copyright (c) 2026 CP Engineering</Copyright>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- NuGet settings -->
    <PackageId>CPE.BlazorQuill</PackageId>
    <!-- Pinned so consumers keep referencing _content/Blazored.TextEditor/... : without this the base path follows PackageId and every consuming index.html would have to change. The _content/ prefix is part of the value - this property REPLACES the whole default base path, it does not just substitute the package-id segment. 1.2.0 shipped without it and served the files from /Blazored.TextEditor/, so consumers 404ed. -->
    <StaticWebAssetBasePath>_content/Blazored.TextEditor</StaticWebAssetBasePath>
    <PackageTags>Blazor;Razor;Components;TextEditor;Rich Text;Quill;QuillJS;ASP.NET Core;CSharp;Web</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/gismofx/TextEditor</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/gismofx/TextEditor</RepositoryUrl>

    <!-- SourceLink settings -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.2.1</Version>
    <PackageReleaseNotes>Fork of Blazored.TextEditor 1.1.3, which is deprecated upstream. Adds one-way and two-way content binding and multiple editors per page.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>
    
  <ItemGroup Condition="'$(TargetFramework)'=='net6.0'">
    <PackageReference Include="Microsoft.JSInterop" Version="6.0.36" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\Blazored-BlazorQuill.js" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <!-- The licence text itself ships inside the package: PackageLicenseExpression only records the SPDX id on nuget.org, which leaves a binary consumer with no notice. -->
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
